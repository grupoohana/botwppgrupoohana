{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {"maxDuration": 60},
    "api/cron.mjs": {"maxDuration": 300}
  },
  "rewrites": [
    {"source": "/api/webhook", "destination": "/api/index"},
    {"source": "/api/health", "destination": "/api/index"},
    {"source": "/api/session", "destination": "/api/index"},
    {"source": "/api/link", "destination": "/api/index"},
    {"source": "/api/account", "destination": "/api/index"},
    {"source": "/api/admin", "destination": "/api/index"},
    {"source": "/api/worker", "destination": "/api/index"}
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"}
    ]
  }]
}
